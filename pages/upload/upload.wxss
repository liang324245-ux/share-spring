.up-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: linear-gradient(160deg, #f5faf6 0%, #f5f9f3 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.up-topbar {
  display: flex;
  align-items: center;
  padding: 10rpx 46rpx;
  flex-shrink: 0;
  margin-bottom: 10rpx;
  margin-top: 70rpx;
}
.up-cancel { font-size: 32rpx; color: #888; }
.up-title { flex:1; text-align: center; font-size: 38rpx; color: #4a4a4a; }
.up-spacer { width: 80rpx; }

.up-scroll { flex: 1; }

.section {
  margin: 28rpx 36rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 36rpx;
  padding: 40rpx;
}
.section-label { font-size: 32rpx; color: #5a5a5a; margin-bottom: 28rpx; }
.up-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.up-photo-wrap { position: relative; width: 180rpx; height: 180rpx; }
.up-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #c8e6c9, #bbdefb);
}
.up-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #888;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  z-index: 2;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}
.add-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  border: 3rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #ccc;
}
.hint { font-size: 26rpx; color: #aaa; margin-top: 24rpx; }

.date-pick { font-size: 32rpx; color: #666; padding: 16rpx 0; }

.cap-input {
  width: 100%;
  height: 140rpx;
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
}
.cap-count { text-align: right; font-size: 24rpx; color: #bbb; }

.publish-btn {
  margin: 40rpx 36rpx 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #4caf72;
  border-radius: 46rpx;
  color: #fff;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6px 18px rgba(76, 175, 114, 0.3);
}
.publish-btn:active { transform: scale(0.98); }

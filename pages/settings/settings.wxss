.set-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: linear-gradient(165deg, #f5faf6 0%, #f4f9f5 50%, #f7faf1 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.set-topbar {
  display: flex;
  align-items: center;
  padding: 12rpx 36rpx;
  margin-top: 80rpx;
  flex-shrink: 0;
}
.back { font-size: 56rpx; color: #3a8c5f; width: 56rpx; }
.set-title { font-size: 40rpx; color: #3a8c5f; margin-left: 16rpx; font-weight: 600; }

.set-scroll { flex: 1; padding: 20rpx 0 80rpx; }

/* 个人资料 */
.set-profile {
  margin: 32rpx 36rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 44rpx;
  padding: 56rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6px 18px rgba(76, 175, 114, 0.08);
}
.big-avatar {
  width: 200rpx;
  height: 220rpx;
  border-radius: 60%;
  background: #ffffff;
  border: 3rpx solid #e6ece8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 94rpx;
  box-shadow: 0 4px 14px rgba(76, 175, 114, 0.12);
  position: relative;
  overflow: hidden;
}
.nickname-input {
margin-top: 40rpx;
margin-left:145rpx;
font-size: 35rpx;
}
/* 头像图片铺满圆框 */
.big-avatar .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
/* 没传头像时的"+"占位 */
.avatar-placeholder {
  font-size: 72rpx;
  color: #b5c9bd;
  font-weight: 300;
  line-height: 1;
}
.edit-badge {
  position: absolute;
  bottom: -6rpx;
  right: -15rpx;
  width: 45rpx;
  height: 45rpx;
  background: #4caf72;
  border-radius: 50%;
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
}
.nickname {
  font-size: 40rpx;
  color: #3a5a48;
  font-weight: 600;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.nickname .pen { font-size: 28rpx; opacity: 0.5; }
.user-sub { font-size: 26rpx; color: #a8bcae; margin-top: 12rpx; }

/* 分组 */
.set-group {
  margin: 32rpx 36rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 44rpx;
  overflow: hidden;
  box-shadow: 0 6px 18px rgba(76, 175, 114, 0.08);
}
.set-group-label { font-size: 26rpx; color: #8aa596; padding: 36rpx 44rpx 16rpx; }
.set-row {
  display: flex;
  align-items: center;
  padding: 32rpx 44rpx;
}
.set-row:active { background: rgba(76, 175, 114, 0.05); }
.set-row + .set-row { border-top: 1rpx solid rgba(76, 175, 114, 0.08); }
.row-icon { width: 48rpx; font-size: 36rpx; }
.row-text { flex: 1; font-size: 32rpx; color: #3a5a48; margin-left: 20rpx; }
.row-arrow { color: #c4d4ca; font-size: 40rpx; }
.row-value { font-size: 28rpx; color: #a8bcae; margin-right: 12rpx; }
.set-danger { color: #e57373 !important; }

/* 开关 */
.switch {
  width: 92rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #d4e4da;
  position: relative;
  transition: 0.25s;
  flex-shrink: 0;
}
.switch.on { background: #4caf72; }
.switch .knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: 0.25s;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}
.switch.on .knob { left: 46rpx; }

/* 退出 */
.set-logout {
  margin: 48rpx 36rpx 0;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 44rpx;
  color: #e57373;
  font-size: 32rpx;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
}

.af-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(160deg, #f5faf6 0%, #cdedde 100%);
  box-sizing: border-box;
}
.af-topbar {
  display: flex;
  align-items: center;
  padding: 12rpx 36rpx;
  margin-top: 40rpx;
}
.back { font-size: 90rpx; color: #999; width: 56rpx; }
.af-title { flex: 1; text-align: center; font-size: 50rpx; color: #4a4a4a; margin-right: 56rpx; }

.af-scroll { padding: 10rpx 0 40rpx; }

/* 卡片：沿用你的 form-block 风格 */
.af-card {
  margin: 34rpx 35rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 36rpx;
  padding: 60rpx 44rpx;
  font-size: 100rpx;
}
.af-center { text-align: center; }

/* 身份切换：沿用你的 role-tabs 胶囊风格 */
.af-role-tabs {
  display: flex;
  background: rgba(255, 254, 254, 0.944);
  border-radius: 80rpx;
  padding: 10rpx;
  margin-bottom: 50rpx;
  margin-top: -20rpx;
}
.af-role {
  flex: 1;
  text-align: center;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 38rpx;
  color: #999;
  border-radius: 80rpx;
  transition: 0.25s;
}
.af-role.on { background: #4caf72; color: #fff; }

/* 标签 + 输入框：沿用你的 form 风格 */
.af-label {
  font-size: 40rpx;
  color: #5a5a5a;
  margin: 8rpx 0 24rpx;
}
.af-input {
  width: 100%;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 50rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #555;
  box-sizing: border-box;
  margin-bottom: 55rpx;
}

/* 上句/下句选择：沿用你的胶囊风格 */
.af-part-tabs {
  display: flex;
  gap: 24rpx;
  margin-bottom: 50rpx;
}
.af-part {
  flex: 1;
  text-align: center;
  height: 86rpx;
  line-height: 86rpx;
  font-size: 38rpx;
  color: #888;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 56rpx;
  transition: 0.25s;
}
.af-part.on {
  background: #4caf72;
  color: #fff;
}

/* 提交按钮：沿用你的 action-btn 风格 */
.af-submit {
  margin: 70rpx auto 10rpx;
  height: 98rpx;
  width: 300rpx;
  line-height: 92rpx;
  text-align: center;
  background: #4caf72;
  border-radius: 56rpx;
  color: #fff;
  font-size: 40rpx;
  letter-spacing: 8rpx;
}
.af-submit:active { transform: scale(0.86); }

/* 等待中状态 */
.af-wait-icon {
  width: 920rpx;
  height: 920rpx;
  margin: 80rpx auto 30rpx;
  display: block;
  margin-left: -170rpx;
  margin-top: -150rpx;
  margin-bottom: -200rpx;
}
.af-wait-title { font-size: 55rpx; color: #4a4a4a; margin-bottom: 18rpx; margin-top: -10rpx;}
.af-wait-sub { font-size: 33rpx; color: #aaa; padding-bottom: 10rpx; }
.af-card{font-size: 100rpx; margin-top: 50rpx;}

/* 选择候选 */
.af-pick-title { font-size: 36rpx; color: #5a5a5a; margin-bottom: 36rpx; }
.af-people {
  display: flex;
  flex-wrap: wrap;
  gap: 44rpx;
}
.af-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 150rpx;
}
.af-avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #e6ece8;
  overflow: hidden;
}
.af-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #9bb3a4;
}
.af-person:active .af-avatar {
  transform: scale(0.92);
  transition: 0.15s;
}
.af-name {
  font-size: 28rpx;
  color: #4a4a4a;
  margin-top: 16rpx;
  max-width: 150rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

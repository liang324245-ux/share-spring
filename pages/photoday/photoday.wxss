.pd-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: linear-gradient(165deg, #f1f8f2 0%, #d2eef0 40%, #eddab7 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 顶部 */
.pd-topbar {
  position: relative;
  height: 20rpx;
  margin-top: 80rpx;
  flex-shrink: 0;
}
.back {
  position: absolute;
  left: 36rpx;
  top: -65rpx;            /* 箭头往上/下：调这个 top，负值往上 */
  font-size: 100rpx;
  color: #3a8c5f;
}
/* 日期卡片标题 */
.pd-zone-head {
  display: flex;
  align-items: center;
  margin: 8rpx 0 20rpx;
}
.pd-zone-date {
  margin-left: auto;        /* 关键：把日期推到最右边 */
  font-size: 40rpx;
  color: #3a8c5f;
  font-weight: 600;
}
/* 滚动区 */
.pd-scroll {
  flex: 1;
  padding: 12rpx 0 60rpx;
}

.pd-empty {
  text-align: center;
  color: #aac0b2;
  font-size: 30rpx;
  padding: 80rpx 0;
  margin-top: 500rpx;
}

/* 区块 */
.pd-zone {
  margin: 30rpx 36rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 44rpx;
  padding: 32rpx;
  box-shadow: 0 6px 18px rgba(76, 175, 114, 0.08);
}

/* 照片网格 */
.pd-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 28rpx;
}
.pd-grid.single { grid-template-columns: 1fr; }
.pd-photo {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ffd9c4, #ffe9a8);
}
.pd-grid.single .pd-photo { aspect-ratio: 4/3; border-radius: 32rpx; }
.pd-photo-img { width: 100%; height: 100%; }
.pd-photo:active { transform: scale(0.95); }

/* 发布者 */
.pd-zone-head {
  display: flex;
  align-items: center;
  margin: 8rpx 0 20rpx;
}
.pd-zone-head .avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a8e6c0, #d4f0b0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}
.pd-zone-who {
  font-size: 30rpx;
  color: #3a5a48;
  font-weight: 600;
  margin-left: 18rpx;
}

/* 文案 */
.pd-caption {
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
  margin: 0 8rpx 16rpx;
}

/* 操作 */
.pd-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 36rpx;
  margin-top: 16rpx;
}
.pd-act-icon {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.pd-act-icon:active { transform: scale(0.85); }
.heart-emoji { font-size: 36rpx; }
.cm-count { font-size: 26rpx; color: #7a9586; }

/* 已读标记 ✓✓✓ */
.pd-read {
  font-size: 28rpx;
  color: #4caf72;
  letter-spacing: -4rpx;
  font-weight: 600;
}
/* 评论 */
.pd-comments {
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(76, 175, 114, 0.12);
  padding-top: 32rpx;
}
.pd-comment {
  font-size: 28rpx;
  color: #555;
  line-height: 1.9;
}
.pd-comment .cm-name { color: #4caf72; font-weight: 500; }

/* 评论输入 */
.pd-comment-input {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  gap: 20rpx;
}
.pd-comment-input input {
  flex: 1;
  height: 84rpx;
  background: rgba(76, 175, 114, 0.06);
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #444;
}
.pd-comment-input .send {
  color: #4caf72;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 12rpx;
}

/* 大图预览 */
.pd-lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 200;
  display: none;
  align-items: center;
  justify-content: center;
}
.pd-lightbox.show { display: flex; }
.pd-lightbox .big {
  width: 80%;
  aspect-ratio: 1;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffd9c4, #ffe9a8);
}
.pd-lightbox .close {
  position: absolute;
  top: 100rpx;
  right: 48rpx;
  color: #fff;
  font-size: 60rpx;
}

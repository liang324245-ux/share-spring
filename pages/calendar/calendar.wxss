.cal-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: linear-gradient(160deg, #f5faf6 0%, #f4f8fb 100%);
  box-sizing: border-box;
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  padding: 0rpx 36rpx 12rpx;
  margin-top: 80rpx;
}
.back {
  font-size: 56rpx;
  color: #3a8c5f;
  width: 56rpx;
}
.cal-friend {
  display: flex;
  align-items: center;
}
.cal-friend .avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a8e6c0, #d4f0b0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.cal-friend .nm {
  font-size: 45rpx;
  color: #4a4a4a;
  margin-left: 0rpx;
  padding-top: -10rpx;
}
.cal-friend .nm-edit {
  font-size: 40rpx;
  color: #9bb3a4;
  margin-left: 12rpx;
}
.spacer { flex: 1; }
.trash { font-size: 40rpx;
  padding-top: -10rpx; }

/* 日历卡片 */
.cal-card {
  margin: 20rpx 36rpx 0;
  background: #fff;
  border-radius: 44rpx;
  padding: 40rpx 22rpx 22rpx;
  box-shadow: 0 8px 24px rgba(76, 175, 114, 0.1);
}

/* 月份导航 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 4rpx 0 32rpx;
}
.cal-ico { font-size: 34rpx; }
.month-label {
  font-size: 36rpx;
  color: #3a8c5f;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.month-nav .arrow {
  font-size: 44rpx;
  color: #cbd8d0;
  padding: 0 12rpx;
}

/* 星期行 */
.week-row { display: flex; }
.week-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #b8c2bc;
  padding: 12rpx 0 24rpx;
}

/* 日期网格 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.day-cell {
  width: 14.28%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
}
.day-inner {
  width: 80rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: 0.15s;
}
.day-num {
  font-size: 30rpx;
  color: #4a4a4a;
}
/* 未读：数字红色 */
.day-num.unread {
  color: #ff5252;
  font-weight: 600;
}
/* 圆点 */
.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 14rpx;
}
.yellow { background: #ffc94d; }
.blue { background: #7bc0f5; }
.green { background: #5cc98a; }
.red { background: #ff6b6b; }

/* 选中日期：绿色方块 */
.day-inner.selected {
  background: #4caf72;
  box-shadow: 0 4px 12px rgba(106, 191, 139, 0.4);
}
.day-inner.selected .day-num {
  color: #fff;
  font-weight: 600;
}
.day-inner.selected .day-dot { display: none; }

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 32rpx 0 0;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

/* 上传浮动按钮 */
.upload-float {
  display: block;
  bottom: 370rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 35%;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #4caf72;
  border-radius: 46rpx;
  color: #fff;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6px 18px rgba(76, 175, 114, 0.55);
  font-family: "sans-serif";
  margin: 65rpx auto 0; 
  margin-right: 110rpx
}
.upload-float:active { transform: translateX(-50%) scale(0.88); }
